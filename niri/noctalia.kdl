layout {

    focus-ring {
        active-color   "#5cd5fb"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#5cd5fb"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#5cd5fb"
        inactive-color "#004e60"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#5cd5fb80"
    }
}

recent-windows {
    highlight {
        active-color "#5cd5fb"
        urgent-color "#ffb4ab"
    }
}
