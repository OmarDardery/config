{
  isNixOS,
  isLaptop,
  pkgs,
  profile,
  ...
}:
{
  environment.systemPackages =
    with pkgs;
    [
      (import ../../pkgs/performance-launchers.nix { inherit pkgs isNixOS isLaptop; }).performanceRun
      kitty
      starship
      zoxide
      fzf
      bat
      eza
      lazygit
      btop
      yazi
      ripgrep
      fd
      tealdeer
      git
      git-lfs
      delta
      gh
      direnv
      nix-direnv
      nh
      nix-output-monitor
      nvd
      nix-tree
      curl
      wget
      jq
      file
      rsync
      zip
      unzip
      _7zz
      lshw
      usbutils
      pciutils
      lsof
      strace
      sysstat
      smartmontools
      nvme-cli
      dnsutils
      nmap
      iperf3
      ethtool
      opencode
      zsh-autosuggestions
      zsh-syntax-highlighting
      (callPackage ../../pkgs/antigravity-cli.nix { })
    ];
  environment.sessionVariables.NH_FLAKE = "path:${profile.configRepo}";
}
