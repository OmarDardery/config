{
  pkgs,
  config,
  lib,
  ...
}:
{
  environment.systemPackages =
    with pkgs;
    [
      kitty
      starship
      zoxide
      fzf
      bat
      eza
      lazygit
      btop
      yazi
      ripgrep
      fd
      tealdeer
      git
      git-lfs
      delta
      gh
      curl
      wget
      jq
      file
      rsync
      zip
      unzip
      _7zz
      zsh-autosuggestions
      zsh-syntax-highlighting
    ]
    ++ lib.optionals config.workstation.diagnostics.enable (
      with pkgs;
      [
        lshw
        usbutils
        pciutils
        lsof
        strace
        sysstat
        smartmontools
        nvme-cli
        dnsutils
        nmap
        iperf3
        ethtool
      ]
    );
}
