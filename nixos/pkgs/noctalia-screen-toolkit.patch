@@ -20 +20,3 @@
 set -euo pipefail
+umask 077
+: "${SCREEN_TOOLKIT_TMPDIR:?private temporary directory required}"
@@ -33 +35,25 @@
+  annotate-window-umbriel)
+    _require umbriel
+    _require jq
+    _require grim
+    TARGET="${2:?missing preview target}"
+    IDENTIFIER=$(umbriel windows --json | jq -er '
+        [.[] | select(.active == true)]
+        | if length == 1 then .[0].id else error("Expected one active window") end
+        | if type == "string" and length > 0 then . else error("Missing window identifier") end
+    ') || { echo "ERROR: could not identify active Umbriel window" >&2; exit 2; }
+    WORK=$(mktemp -d "$SCREEN_TOOLKIT_TMPDIR/umbriel.XXXXXXXXXXXX")
+    trap 'rm -rf -- "$WORK"' EXIT
+    trap 'exit 130' INT
+    trap 'exit 143' TERM
+    # Capture the isolated client, never a geometry crop of overlapping windows.
+    grim "${GRIM_CURSOR_ARGS[@]}" -T "$IDENTIFIER" "$WORK/capture.png" \
+        || { echo "ERROR: Umbriel window capture failed" >&2; exit 2; }
+    [ -s "$WORK/capture.png" ] \
+        || { echo "ERROR: Umbriel window capture is empty" >&2; exit 2; }
+    mv -- "$WORK/capture.png" "$TARGET" \
+        || { echo "ERROR: could not publish Umbriel preview" >&2; exit 2; }
+    printf '%s\n' "0,0 0x0"
+    ;;
+
   annotate-window)
