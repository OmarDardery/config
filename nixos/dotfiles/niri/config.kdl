include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/outputs.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

// Noctalia's wallpaper-derived colours. Last, so they win over cfg/layout.kdl —
// that is the point of them, and layout.kdl's own colours are what you get
// whenever this file is absent.
//
// It lives outside ~/.config/niri because this directory is a read-only store
// symlink and noctalia has to be able to write it. `optional=true` is what
// makes that safe: without it a missing file is a fatal config error, and on a
// fresh machine noctalia has not rendered anything yet. niri watches the path
// even while it does not exist, so the theme applies the moment it appears.
//
// The matching template and output path are in dotfiles/noctalia/config.toml.
include optional=true "~/.local/state/noctalia/theme/niri.kdl"
