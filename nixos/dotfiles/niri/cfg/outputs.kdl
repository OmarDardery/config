// ────────────── Outputs (machine-specific) ──────────────
// The panel is matched by its make/model/serial, NOT by connector name.
//
// This laptop has two eDP connectors — one on the AMD iGPU (the real panel)
// and one on the NVIDIA card (permanently disconnected). Which one gets
// numbered eDP-1 and which gets eDP-2 depends on whether amdgpu or nvidia
// probes first, and that races differently across boots. Both names have been
// observed on the real panel, so hardcoding either one silently disables this
// block on roughly half of all boots.
//
// The descriptor below is what `niri msg outputs` prints in quotes, and it is
// stable. Run that command if the panel is ever swapped.

output "BOE NE140QDM-NX7 Unknown" {
    mode "2560x1600@165.000"

    scale 1.5

    transform "normal"
    position x=0 y=0
}

// Logical width of the panel at scale 1.5 is 1706, so the external display starts
// there. The old value of 1710 left a 4 px dead gap the pointer fell into.
output "HDMI-A-1" {
    mode "1920x1080@60.000"

    scale 1.0

    transform "normal"
    position x=1706 y=0
}
