// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup
// Applications ──────────────
spawn-at-startup "noctalia"

// Correct syntax: discrete string arguments for the binary
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=niri"

// REMOVED: gnome-keyring-daemon (SDDM PAM handles this natively now)
// Verified: /etc/pam.d/sddm substacks /etc/pam.d/login, and login carries the
// pam_gnome_keyring.so auth/password/session lines. Nothing to spawn here.


