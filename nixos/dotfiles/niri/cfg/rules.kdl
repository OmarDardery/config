// -------------------------
// WINDOW RULES
// -------------------------
//
// ── Do not blame this file for the flicker ───────────────────────────────
// Blur, rounded corners and shadows were all disabled here for a while on
// the theory that compositing was too expensive for a 15 W iGPU. That theory
// is dead: the untouched copy of this config at
// codeberg.org/oadardery/dotfiles ran for months with blur, corners, shadows
// AND the same opacity values below, and never flickered. Disabling them
// changed nothing. They are back on, and they stay on.
// ─────────────────────────────────────────────────────────────────────────

// Global: Applies to all windows
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Terminals: Slightly more transparent (looks nicer with blur)
window-rule {
    match app-id="foot"
    match app-id="kitty"
    match app-id="alacritty"
    opacity 0.88
    background-effect {
    	blur true
    }
}

window-rule {
    match app-id="nautilus"
    opacity 0.8
    background-effect {
    	blur true
    }
}

// Zen Browser: enable blur and prevent background color drawing behind transparent window
window-rule {
    match app-id=r"^zen"
    draw-border-with-background false
    shadow {
        off
    }
    background-effect {
        blur true
    }
}


// Steam games: open fullscreen.
// Steam launches games under XWayland with app-id "steam_app_<appid>";
// the Steam client itself is app-id "steam" and is deliberately not matched.


// ── Presenting onto HDMI ─────────────────────────────────────────────────
// Normally nothing is needed here. LibreOffice's gtk3 backend asks the
// compositor to fullscreen the slide window on a named output
// (xdg_toplevel.set_fullscreen with a wl_output), and niri honours that —
// which is what SAL_USE_VCLPLUGIN=gtk3 in home/apps.nix restored. The Qt
// backend never sends the output at all, which is why this used to need
// wl-mirror.
//
// If a deck still opens on the laptop panel, niri can place it instead. Start
// a presentation, run `niri msg windows`, and copy the REAL app-id and title
// into the rule below before uncommenting — Impress puts the slides and the
// presenter console in two separate toplevels, and only the slides should
// move. Guessing here silently moves the wrong one.
//
// window-rule {
//     match app-id=r"libreoffice" title=r"<the title niri msg windows printed>"
//     open-on-output "HDMI-A-1"
//     open-fullscreen true
// }

// -------------------------
// LAYER RULES (WALLPAPER / BACKDROP)
// ------------------------

layer-rule {
    match namespace="^noctalia-wallpaper.*"
    place-within-backdrop true
}
