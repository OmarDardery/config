// -------------------------
// WINDOW RULES
// -------------------------
//
// ── Do not blame this file for the flicker ───────────────────────────────
// Blur, rounded corners and shadows were all disabled here for a while on
// the theory that compositing was too expensive for a 15 W iGPU. That theory
// is dead: the untouched copy of this config at
// codeberg.org/oadardery/dotfiles ran for months with blur, corners, shadows
// AND the same opacity values below, and never flickered. Disabling them
// changed nothing. They are back on, and they stay on.
// ─────────────────────────────────────────────────────────────────────────

// Global: Applies to all windows
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Terminals: Slightly more transparent (looks nicer with blur)
window-rule {
    match app-id="foot"
    match app-id="kitty"
    match app-id="alacritty"
    opacity 0.88
    background-effect {
    	blur true
    }
}

window-rule {
    match app-id="nautilus"
    opacity 0.8
    background-effect {
    	blur true
    }
}

// Zen Browser: enable blur and prevent background color drawing behind transparent window
window-rule {
    match app-id=r"^zen"
    draw-border-with-background false
    shadow {
        off
    }
    background-effect {
        blur true
    }
}


// -------------------------
// LAYER RULES (WALLPAPER / BACKDROP)
// ------------------------

layer-rule {
    match namespace="^noctalia-wallpaper.*"
    place-within-backdrop true
}
