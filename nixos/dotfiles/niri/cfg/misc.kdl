	prefer-no-csd
    screenshot-path null

    environment {
        // Fix for STM32CubeMX (Java AWT) blank/missing UI elements on Wayland
        _JAVA_AWT_WM_NONREPARENTING "1"
        
        // Force Electron apps to use native Wayland instead of lagging in XWayland
        ELECTRON_OZONE_PLATFORM_HINT "wayland"
        
        QT_QPA_PLATFORM "wayland"
        QT_QPA_PLATFORMTHEME "gtk3"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
        XDG_CURRENT_DESKTOP "niri"
        XDG_SESSION_TYPE "wayland"

        // XCURSOR_THEME/XCURSOR_SIZE deliberately not set here. They come from
        // home.pointerCursor (home/desktop.nix), which is the single source of
        // truth. This block used to set Ice while everything else said Classic,
        // so clients got a different cursor from the compositor.
}

    cursor {
        xcursor-theme "Bibata-Modern-Classic"
        xcursor-size 24
    }

    debug {
        // Allows notification actions and window activation from Noctalia.
        honor-xdg-activation-with-invalid-serial

        // Windows flickering to a single frame of the wallpaper: niri-wm/niri#2030,
        // still open. Reported to fix it in niri-wm/niri#2477, and the debug-options
        // wiki gives it as the general answer to "niri runs but the screen flickers".
        // Makes niri wait for a frame to finish rendering before handing it to DRM,
        // trading some render throughput for never queueing an incomplete frame.
        // See hardware.nix for why the earlier iGPU/DPM explanation was wrong.
        //
        // If this is not enough, `disable-direct-scanout` is the next thing to try.
        // It has NOT been tested — it is absent from the ruled-out list in
        // hardware.nix because nobody got to it, not because it was eliminated.
        wait-for-frame-completion-before-queueing
}

    hotkey-overlay {
       skip-at-startup
}
switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

// The deleted noctalia.kdl was the only place these were set, so without this
// block they would quietly fall back to niri's defaults. Matched to the
// focus-ring colours in cfg/layout.kdl.
recent-windows {
    highlight {
        active-color "#22466e"
        urgent-color "#5e0b52"
    }
}
